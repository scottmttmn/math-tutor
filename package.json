{
  "name": "claude-math-temp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "node scripts/copy-tldraw-assets.mjs && node scripts/copy-pdfjs-assets.mjs",
    "predev": "node scripts/check-deps.mjs",
    "dev": "next dev --webpack",
    "prebuild": "node scripts/check-deps.mjs",
    "build": "next build --webpack",
    "build:android": "node scripts/check-deps.mjs && BUILD_TARGET=android next build --webpack && cap sync android",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit",
    "test:e2e": "npm run test:board:e2e && npm run test:tutor:e2e && npm run test:shelf:e2e && npm run test:backup:e2e && npm run test:memory:e2e && npm run test:checkin:e2e && npm run test:writeup:e2e && npm run test:pen:e2e",
    "test:unit": "node --test tests/tutor.test.mjs tests/bookContext.test.mjs tests/history.test.mjs tests/tutorContent.test.mjs tests/handwritingScore.test.mjs tests/backup.test.mjs tests/learnerProfile.test.mjs tests/checkIn.test.mjs tests/texWriteUp.test.mjs",
    "test:board:e2e": "node tests/board.e2e.mjs",
    "test:tutor:e2e": "node tests/tutorChat.e2e.mjs",
    "test:shelf:e2e": "node tests/shelf.e2e.mjs",
    "test:backup:e2e": "node tests/backup.e2e.mjs",
    "test:memory:e2e": "node tests/memory.e2e.mjs",
    "test:checkin:e2e": "node tests/checkin.e2e.mjs",
    "test:writeup:e2e": "node tests/writeUp.e2e.mjs",
    "test:pen:e2e": "node tests/penTest.e2e.mjs",
    "handwriting": "node scripts/handwriting/run.mjs",
    "test:android:e2e": "node tests/androidExport.e2e.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.78.0",
    "@capacitor/android": "8.5.3",
    "@capacitor/core": "8.5.3",
    "@napi-rs/keyring": "^2.1.0",
    "@tldraw/assets": "5.4.2",
    "geist": "^1.7.2",
    "idb": "^8.0.3",
    "jose": "^6.2.12",
    "katex": "^0.18.9",
    "next": "16.1.6",
    "openai": "^6.25.0",
    "pdfjs-dist": "6.4.299",
    "proper-lockfile": "^4.1.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "tldraw": "5.4.2",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@tailwindcss/postcss": "^4",
    "@types/katex": "^0.16.8",
    "@types/node": "^20",
    "@types/proper-lockfile": "^4.1.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/uuid": "^10.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "playwright": "^1.58.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
